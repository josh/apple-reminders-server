{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["swift", "github-actions"],
  "rebaseWhen": "behind-base-branch",
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "minor"],
      "assignees": ["merge-bot"]
    }
  ]
}
