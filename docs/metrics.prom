# Synthetic exposition example; values are illustrative.
# HELP process_start_time_seconds Start time of the process since the Unix epoch; a change is a restart.
# TYPE process_start_time_seconds gauge
process_start_time_seconds 1793000000
# HELP reminders_http_requests_total HTTP requests answered, by route and status code.
# TYPE reminders_http_requests_total counter
reminders_http_requests_total{route="/graphql",code="200"} 12
reminders_http_requests_total{route="/mcp",code="200"} 7
reminders_http_requests_total{route="/metrics",code="200"} 30
reminders_http_requests_total{route="other",code="404"} 1
# HELP reminders_main_actor_heartbeat_age_seconds Seconds since the main actor last ran a watchdog heartbeat; the process exits past 120.
# TYPE reminders_main_actor_heartbeat_age_seconds gauge
reminders_main_actor_heartbeat_age_seconds 4.5
# HELP reminders_authorization_pending 1 while the startup Reminders access request has not finished; /graphql and /mcp answer 503 meanwhile.
# TYPE reminders_authorization_pending gauge
reminders_authorization_pending 0
# HELP reminders_eventkit_up 1 when the last background EventKit read succeeded and its gauges follow.
# TYPE reminders_eventkit_up gauge
reminders_eventkit_up 1
# HELP reminders_accounts Number of accounts with accessible reminder lists.
# TYPE reminders_accounts gauge
reminders_accounts 1
# HELP reminders_lists Number of accessible reminder lists in an account.
# TYPE reminders_lists gauge
reminders_lists{account_id="account-example"} 1
# HELP reminders_list_info Reminder list identity and name, with value 1.
# TYPE reminders_list_info gauge
reminders_list_info{account_id="account-example",list_id="list-example",name="Example"} 1
# HELP reminders_scheduled_items Reminders with a due date in each list, including completed ones.
# TYPE reminders_scheduled_items gauge
reminders_scheduled_items{account_id="account-example",list_id="list-example"} 2
# HELP reminders_recurring_items Reminders with stored recurrence rules in each list, including completed ones.
# TYPE reminders_recurring_items gauge
reminders_recurring_items{account_id="account-example",list_id="list-example"} 0
# HELP reminders_items_with_alarms Reminders with alarms in each list, including completed ones.
# TYPE reminders_items_with_alarms gauge
reminders_items_with_alarms{account_id="account-example",list_id="list-example"} 0
# HELP reminders_items Number of reminders by completion status, priority (none 0, high 1-4, medium 5, low 6-9), and deadline status.
# TYPE reminders_items gauge
reminders_items{account_id="account-example",list_id="list-example",status="incomplete",priority="none",due_status="overdue"} 0
reminders_items{account_id="account-example",list_id="list-example",status="incomplete",priority="none",due_status="today"} 0
